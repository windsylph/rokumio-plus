<?xml version="1.0" encoding="utf-8"?>
<component name="RailTile" extends="Group">
    <!-- One button of the Stremio-style vertical nav bar (stremio-web
         VerticalNavBar/NavTabButton): icon at 35% when idle; the focused or
         selected button turns the icon purple, shows its label under it and,
         when focused, sits on a rounded overlay (rgba(255,255,255,0.05)+). -->
    <interface>
        <field id="focused" type="boolean" alwaysNotify="true" />
        <field id="selected" type="boolean" alwaysNotify="true" />
        <!-- Kept for HomeScreen's rail calls; the Stremio bar never widens. -->
        <field id="expanded" type="boolean" alwaysNotify="true" />
        <function name="SetTile" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/RailTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <children>
        <Poster id="railFace" width="104" height="96" translation="[8, 0]" uri="pkg:/images/ui/panel.9.png" blendColor="0xFFFFFF1F" visible="false" />
        <Poster
            id="railGlyph"
            width="44"
            height="44"
            loadWidth="44"
            loadHeight="44"
            loadDisplayMode="limitSize"
            translation="[38, 14]" />
        <Label
            id="railLabel"
            translation="[12, 62]"
            width="96"
            height="26"
            horizAlign="center"
            vertAlign="center"
            visible="false" />
    </children>
</component>
