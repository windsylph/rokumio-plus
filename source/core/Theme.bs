' Theme.bs — the app's single source of truth for colors.
'
' Every component that paints custom colors reads them from Theme() instead of
' hardcoding hex literals, so the whole look is driven from this one file. The
' palette is cached on the caller's m (each component keeps its own copy), and
' the values are byte-identical to the literals they replace.
'
' XML cannot call code, so XML color attributes are migrated into each
' component's init() and assigned from here. The transparent "0x0" backdrops
' are the absence of color, not a theme, and stay literal in the XML.
'
' The native dialogs keep Roku's RSGPalette shape; AppPalette() builds that
' node from the same palette so the dialogs share the app's look.
'
' danger is the one color that is not part of the app's look: it marks a broken
' invariant (see MainScene's Notify) rather than styling content, and
' it lives here anyway so nothing in the codebase has to hardcode a hex literal.
function Theme() as object
    if m._theme = invalid
        m._theme = {
            ' Stremio's palette (stremio-web src/App/styles.less): near-black
            ' violet backgrounds, the purple primary accent, white foreground.
            accent: "0x7B5BF5FF"
            accentFocus: "0x9A82FFFF"
            accentClear: "0x7B5BF500"
            accentDim: "0x7B5BF54D"
            accentFaint: "0x7B5BF533"
            accentWarm: "0xF6C700FF"
            accentInfo: "0x5BCBF4FF"
            onAccent: "0xFFFFFFFF"
            textPrimary: "0xFFFFFFE6"
            textSecondary: "0xFFFFFF80"
            textWhite: "0xFFFFFFFF"
            chipActiveBg: "0xFFFFFF26"
            chipActiveText: "0xFFFFFFE6"
            danger: "0xDC2626FF"
            screenBg: "0x0C0B11FF"
            tileFace: "0x15131EFF"
            tileFaceFocus: "0x2A2547FF"
            itemFace: "0x1A173EFF"
            dropdownBg: "0x0F0D20FF"
            playerBg: "0x000000FF"
            scrim: "0x0C0B1199"
            progressTrack: "0x00000073"
            progressFill: "0x7B5BF5FF"
            glyphPlate: "0x0C0B11A6"
            borderSoft: "0xFFFFFF1A"
            navBg: "0x0C0B11C0"
            navBgExpanded: "0x0F0D20FF"
            navIdle: "0xFFFFFF66"
            navLabelActive: "0xFFFFFFE6"
            toastBg: "0x0F0D20E6"
            segmentIdle: "0x221F33FF"
        }
    end if
    return m._theme
end function

' The RSGPalette for the native StandardDialogs and the dynamic keyboards,
' assembled from the app palette so dialogs and keyboards restyle with the
' rest of the app. The two naming families coexist because each consumer
' reads only its own: StandardDialogs look up the Dialog* names, the
' DynamicKeyGrid looks up KeyboardColor/PrimaryTextColor/FocusColor/
' FocusItemColor/SecondaryItemColor.
function AppPalette() as object
    c = Theme()
    palette = CreateObject("roSGNode", "RSGPalette")
    palette.colors = {
        DialogBackgroundColor: c.dropdownBg
        DialogItemColor: c.accent
        DialogTextColor: c.textPrimary
        DialogFocusColor: c.accent
        DialogFocusItemColor: c.onAccent
        DialogSecondaryTextColor: c.textSecondary
        DialogSecondaryItemColor: c.accentDim
        DialogInputFieldColor: c.dropdownBg
        DialogKeyboardColor: c.dropdownBg
        DialogFootprintColor: c.accentFaint
        KeyboardColor: c.dropdownBg
        PrimaryTextColor: c.textPrimary
        SecondaryItemColor: c.textSecondary
        FocusColor: c.accent
        FocusItemColor: c.onAccent
    }
    return palette
end function
